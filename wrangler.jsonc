{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "super-meadow-3240",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babushkina-community",
      "database_id": "cc9656f5-74b0-4cdd-8b8d-c907ed6fadc1"
    }
  ]
}
